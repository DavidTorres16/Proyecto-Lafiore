---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import Treatments from '../components/Treatments.astro';
import PostOp from '../components/PostOp.astro';
import Spotlight from '../components/Spotlight.astro';
import Testimonial from '../components/Testimonial.astro';
import Visit from '../components/Visit.astro';
import About from '../components/About.astro';
import Closing from '../components/Closing.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base
  title="Lafiore Medical Skin Center | Rejuvenecimiento facial en Armenia"
  description="Rejuvenecimiento facial, calidad de piel, tratamientos corporales y recuperación post operatoria en Armenia, Quindío, junto al Dr. Javier Flórez, cirujano plástico facial."
>
  <Header />
  <main>
    <Hero />
    <Proof />
    <Treatments />
    <PostOp />
    <Spotlight />
    <Testimonial />
    <Visit />
    <About />
  </main>
  <Closing />
  <WhatsAppFab />
</Base>
