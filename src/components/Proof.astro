---
import Icon from './Icon.astro';
import { site } from '../data/site';

const facts = [
  { icon: 'seal-check', text: 'Perfil verificado, con una comunidad de más de 9.500 personas' },
  { icon: 'stethoscope', text: `Alianza con el ${site.surgeon}, cirujano plástico facial` },
  { icon: 'sparkle', text: 'Tecnología Venus Concept y MP2 en cabina' },
  { icon: 'hand-heart', text: 'Patrocinadores oficiales de la Carrera ADN Rosa' },
];
---

<section aria-label="Por qué Lafiore" class="border-y border-line bg-surface/60">
  <ul class="mx-auto grid max-w-7xl gap-x-10 gap-y-6 px-4 py-9 sm:grid-cols-2 md:px-8 lg:grid-cols-4">
    {
      facts.map((fact, i) => (
        <li data-reveal style={`--i:${i}`} class="flex items-start gap-3 text-[15px] leading-snug text-ink-soft">
          <span class="mt-0.5 shrink-0 text-accent">
            <Icon name={fact.icon} size={24} />
          </span>
          {fact.text}
        </li>
      ))
    }
  </ul>
</section>
