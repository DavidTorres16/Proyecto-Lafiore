---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<section id="nosotras" class="scroll-mt-20 py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 md:grid-cols-12 md:gap-8 md:px-8">
    <div class="md:col-span-5 md:pt-10">
      <h2 data-reveal class="font-display text-4xl leading-[1.08] font-medium text-balance md:text-[56px]">
        Un equipo que te conoce <em class="font-normal text-accent">por tu nombre</em>
      </h2>
      <p data-reveal style="--i:1" class="mt-6 max-w-[46ch] text-lg leading-relaxed text-ink-soft">
        Detrás de Lafiore hay un equipo de mujeres que acompaña cada proceso de cerca, en un espacio pensado para que
        te sientas en casa.
      </p>
      <p data-reveal style="--i:2" class="mt-4 max-w-[46ch] text-lg leading-relaxed text-ink-soft">
        Para los casos post quirúrgicos trabajamos junto al{' '}
        <a href={site.surgeonInstagram} target="_blank" rel="noopener" class="font-medium text-ink underline decoration-bloom underline-offset-4 hover:decoration-accent">{site.surgeon}</a>,
        cirujano plástico facial.
      </p>
      <p data-reveal style="--i:3" class="mt-8 flex items-start gap-3 text-[15px] leading-snug text-ink-soft">
        <span class="mt-0.5 shrink-0 text-accent"><Icon name="hand-heart" size={22} /></span>
        Somos patrocinadores oficiales de la Carrera ADN Rosa, junto a la Fundación Lazo Rosa.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 md:col-span-7 md:gap-5">
      <figure data-reveal class="arch row-span-2 overflow-hidden bg-surface">
        <img
          src="/img/fundadora.webp"
          alt="Fundadora de Lafiore frente al mural de flores del centro"
          width="380"
          height="790"
          loading="lazy"
          class="size-full object-cover"
        />
      </figure>
      <figure data-reveal style="--i:1" class="overflow-hidden rounded-3xl bg-surface">
        <img
          src="/img/equipo-sele.webp"
          alt="Integrante del equipo Lafiore con uniforme azul"
          width="382"
          height="784"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover object-top"
        />
      </figure>
      <figure data-reveal style="--i:2" class="overflow-hidden rounded-3xl bg-surface">
        <img
          src="/img/evento.webp"
          alt="Equipo de Lafiore en un evento en Armenia"
          width="774"
          height="628"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />
      </figure>
    </div>
  </div>
</section>
